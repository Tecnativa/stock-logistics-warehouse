#: model:ir.module.module,description:base.module_stock_secondary_unit
msgid ""
"====================\n"
"Stock Secondary Unit\n"
"====================\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! This file is generated by oca-gen-addon-readme !!\n"
"   !! changes will be overwritten.                   !!\n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
